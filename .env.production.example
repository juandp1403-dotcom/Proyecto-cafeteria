# HU-02: variables obligatorias para un despliegue en produccion. A
# diferencia de .env.example (uso local/desarrollo), aqui NINGUNA de
# estas variables tiene un valor por defecto seguro -- si falta alguna,
# la app se niega a arrancar (ver create_app() en app.py) en vez de
# caer en un estado inseguro (SQLite efimero, SECRET_KEY del codigo,
# tunel SSH sin verificar host).

FLASK_ENV=production

# Obligatoria. 32+ caracteres, generada una sola vez y nunca commiteada.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Conexion a la base de datos real (persistente, no SQLite). Usa
# DATABASE_URL directo O el tunel SSH (SSH_HOST + DB_*), no ambos.
DATABASE_URL=postgresql://usuario:clave@host:5432/cafeteria

# --- Alternativa: tunel SSH hacia la base de datos ---
# SSH_HOST=servidor.ejemplo.com
# SSH_PORT=22
# SSH_USER=usuario_ssh
# SSH_KEY=/ruta/a/la/llave_privada_ssh
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=usuario_bd
# DB_PASS=clave_bd
# DB_NAME=cafeteria
#
# Si se usa SSH_HOST, SSH_HOST_KEY es obligatoria en produccion (falla
# el arranque sin ella -- ver HU-43). Obtenerla una vez con:
# ssh-keyscan -t ed25519 <tu-host-ssh>
# SSH_HOST_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...

# Cuentas semilla: si se dejan vacias, el arranque genera una
# contraseña aleatoria por cuenta y la imprime UNA VEZ en el log --
# definirlas explicitamente es la opcion recomendada para produccion.
ADMIN_DOCUMENTO=<definir-aqui>
ADMIN_NOMBRE=<definir-aqui>
ADMIN_EMAIL=<definir-aqui>
ADMIN_PASSWORD=<definir-aqui>

CAJERO_DOCUMENTO=<definir-aqui>
CAJERO_NOMBRE=<definir-aqui>
CAJERO_EMAIL=<definir-aqui>
CAJERO_PASSWORD=<definir-aqui>

# El rol interno guardado en BD es 'despachador'; el nombre de estas
# variables se mantiene por compatibilidad con despliegues existentes.
ENTREGADOR_DOCUMENTO=<definir-aqui>
ENTREGADOR_NOMBRE=<definir-aqui>
ENTREGADOR_EMAIL=<definir-aqui>
ENTREGADOR_PASSWORD=<definir-aqui>
