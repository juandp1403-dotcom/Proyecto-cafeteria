SECRET_KEY=cambia-esto-por-una-clave-segura
DATABASE_URL=postgresql://usuario:clave@host:5432/cafeteria
FLASK_ENV=development

# Clave de host del servidor SSH usado para el tunel hacia la base de datos
# (solo si se usa SSH_HOST). Sin esto, el tunel acepta cualquier clave de
# host del servidor remoto (riesgo de intercepcion MITM). Se obtiene una
# vez con: ssh-keyscan -t ed25519 <tu-host-ssh>
# SSH_HOST_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...

# Administrador
ADMIN_DOCUMENTO=1000000
ADMIN_NOMBRE=Administrador SENA
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=ClaveSegura123*

# Cajero
CAJERO_DOCUMENTO=2000000
CAJERO_NOMBRE=Cajero Principal
CAJERO_EMAIL=cajero@ejemplo.com
CAJERO_PASSWORD=ClaveSegura123*

# Entregador / despachador (el rol interno guardado en BD es 'despachador',
# el nombre de estas variables se deja igual para no romper despliegues ya configurados)
ENTREGADOR_DOCUMENTO=3000000
ENTREGADOR_NOMBRE=Entregador Principal
ENTREGADOR_EMAIL=entregador@ejemplo.com
ENTREGADOR_PASSWORD=ClaveSegura123*
